{
  "name": "kurz",
  "version": "1.1.0",
  "description": "A light, fast, open-source link shortener for Cloudflare Workers.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:ui && cf dev",
    "dev:ui": "vite",
    "build:ui": "vite build",
    "build": "npm run build:ui && cf build",
    "deploy": "npm run build:ui && cf deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "set-password": "node scripts/set-password.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "hono": "^4.10.0",
    "preact": "^10.27.0",
    "uqr": "^0.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@preact/preset-vite": "^2.10.0",
    "cf": "^1.0.0-rc.4",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.167.0"
  }
}